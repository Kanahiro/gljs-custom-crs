{
  "name": "glsj-custom-crs",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "packageManager": "pnpm@11.21.0",
  "engines": {
    "node": ">=24 <25"
  },
  "scripts": {
    "dev": "pnpm build:worker && vite --host 127.0.0.1",
    "build:worker": "esbuild src/projection-worker.ts --bundle --format=iife --platform=browser --outfile=public/projection-worker.js",
    "build": "pnpm build:worker && vite build",
    "preview": "vite preview --host 127.0.0.1",
    "check": "svelte-check --tsconfig ./tsconfig.json && tsc --noEmit",
    "test": "vitest run",
    "format": "prettier --write .",
    "format:check": "prettier --check ."
  },
  "dependencies": {
    "maplibre-gl": "6.15.0",
    "proj4": "^2.15.0",
    "svelte": "^5.46.4"
  },
  "devDependencies": {
    "@sveltejs/vite-plugin-svelte": "^7.0.0",
    "@types/geojson": "^7946.0.16",
    "esbuild": "^0.28.0",
    "prettier": "^3.9.10",
    "prettier-plugin-svelte": "^3.5.2",
    "svelte-check": "^4.0.0",
    "typescript": "^6.0.0",
    "vite": "^8.0.0",
    "vitest": "^5.0.0"
  }
}
